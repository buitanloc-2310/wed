{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wed",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/assets/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "wed", "database_id": "e08566ab-be0d-49de-8d6a-e884912c765d", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "wed" }],
  "vars": { "SITE_ORIGIN": "https://skyfirst.io.vn" }
}
